APP_ENV=production
APP_DEBUG=false
APP_URL=https://localhost
APP_TIMEZONE=Europe/Berlin
APP_NAME=PatSign
APP_KEY=change-me

DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=patsign
DB_USERNAME=patsign
DB_PASSWORD=patsign

SESSION_SECURE=true
# Set SESSION_SECURE=false when running over plain HTTP (e.g. local development without TLS).
# When SESSION_SECURE is not set the application auto-detects HTTPS.
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Strict
SESSION_LIFETIME=120

VISION_HOST=http://vision-api
VISION_PORT=11434
VISION_API_KEY=local-key
VISION_MODEL=vision-local
VISION_TIMEOUT=60

ANALYSIS_HOST=http://analysis-api
ANALYSIS_PORT=11435
ANALYSIS_API_KEY=local-key
ANALYSIS_MODEL=gemma-4-e4b
ANALYSIS_TIMEOUT=45

IMPORT_WATCH_PATH=/var/www/html/storage/imports
NETWORK_SHARE_PATH=/var/www/html/storage/network-share
MAX_UPLOAD_BYTES=15728640
ALLOWED_UPLOAD_MIME=application/pdf

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=
SMTP_FROM=clinic@example.local
SMTP_FROM_NAME=PatSign
