{
  "name": "dareinelt/patsign",
  "description": "Lokale Webanwendung zur Digitalisierung des Patienten-Unterschriftenprozesses",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.4",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-curl": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "monolog/monolog": "^3.7",
    "phpmailer/phpmailer": "^6.9"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --colors=always",
    "migrate": "php database/migrate.php"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
